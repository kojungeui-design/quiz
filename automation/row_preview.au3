; =====================================================================
; 행 위치 계산 확인 (안전, 클릭 안 함)
; 회로번호 → 화면 세로위치(y) 계산이 맞는지, 마우스만 움직여 확인한다.
;
; 공식:  y = BASE_Y + ROW_H * (회로index)    (index: Batt0007=0, 0008=1, ...)
; 여러 줄로 마우스를 옮기며, 그 줄이 어느 Batt인지 표시.
; 마우스가 표시된 Batt 줄에 정확히 올라가면 공식이 맞는 것.
; 아래로 갈수록 어긋나면 ROW_H 를 미세조정한다.
;
; ※ BTS-600 메인 그리드(회로 목록)가 보이는 상태에서 실행.
; =====================================================================

Global $BASE_Y = 212     ; Batt0007(첫 줄)의 y
Global $ROW_H  = 17      ; 한 줄 높이(px)
Global $COL_X  = 55      ; 배터리 열 x

; 확인할 지점: index, 그 줄의 Batt 이름
Local $checks[7][2] = [ _
    [0,  "Batt0007 (첫 줄)"], _
    [5,  "Batt0012"], _
    [10, "Batt0017"], _
    [15, "Batt0022"], _
    [20, "Batt0027"], _
    [25, "Batt0032"], _
    [31, "Batt0038 (거의 끝)"] ]

For $i = 0 To UBound($checks) - 1
    Local $idx = $checks[$i][0]
    Local $y = $BASE_Y + $ROW_H * $idx
    MouseMove($COL_X, $y, 15)
    ToolTip("여기가 " & $checks[$i][1] & " 줄이어야 함  (y=" & $y & ")", 10, 10)
    Sleep(2500)
Next
ToolTip("확인 끝! 마우스가 각 Batt 줄에 잘 올라갔나요?", 10, 10)
Sleep(2500)
