; =====================================================================
; 좌표 확인 (안전) — 클릭하지 않고 마우스만 각 위치로 움직인다.
; 마우스가 각 버튼에 정확히 올라가는지 눈으로 확인하는 용도.
; 클릭을 안 하므로 BTS-600을 전혀 건드리지 않는다 (크래시 없음).
;
; 사용법:
;   1) BTS-600에서 Export 대화상자를 띄워둔다 (Test sections → Export)
;   2) 이 스크립트 실행 → 마우스가 2.5초씩 각 위치로 이동 + 설명 표시
;   3) 마우스가 해당 버튼에 정확히 올라가는지 확인
;   4) 어긋나면 얼마나 어긋났는지 알려주면 좌표를 보정한다
; =====================================================================

Local $spots[5][3] = [ _
    [180, 565, "Destination file 입력칸"], _
    [640, 487, "Copy 버튼"], _
    [640, 567, "Ok 버튼"], _
    [640, 526, "(대화상자) Cancel 버튼"], _
    [810, 278, "Export 버튼 (대화상자 뒤 Test sections)"] ]

For $i = 0 To UBound($spots) - 1
    MouseMove($spots[$i][0], $spots[$i][1], 20)
    ToolTip($spots[$i][2] & "  (" & $spots[$i][0] & ", " & $spots[$i][1] & ")", 10, 10)
    Sleep(2500)
Next
ToolTip("확인 끝. 어긋난 곳이 있으면 알려주세요.", 10, 10)
Sleep(2000)
